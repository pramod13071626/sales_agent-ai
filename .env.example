# ==========================================
# Sales AI Intelligence Engine - Environment Template
# ==========================================

# PostgreSQL Database Configuration
POSTGRES_DB=sales_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sales_ai

# Redis & Celery Distributed Task Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_SCHEDULE_DAYS=15

# API Keys & Scraper Tokens
APIFY_TOKEN=your_apify_api_token_here
MONID_API_KEY=your_monid_api_key_here
MONID_BASE_URL=https://api.monid.ai/v1

# AI Search & Neural Intelligence APIs
TAVILY_API_KEY=your_tavily_api_key_here
EXA_API_KEY=your_exa_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# Pipeline Configuration
DEFAULT_HIERARCHY_LIMIT=50
OUTPUT_DIR=output
